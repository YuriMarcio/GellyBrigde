# ============================================================================
# API HTTP (api/)
# ============================================================================
FLOWBRIDGE_API_KEY=tandercatxauxau
FLOWBRIDGE_PUBLIC_URL=https://flowbridge.seudominio.com
# 3000, 3333, 8081, 80 e 443 já estão em uso no servidor (evolution_frontend, api-api,
# evolution_adminer, caddy) — 3001 é a próxima livre.
PORT=3001

# ============================================================================
# Postgres (Supabase ou qualquer outro Postgres gerenciado) — persistência das instâncias
# (obrigatório; a API não sobe sem isso). Pegue em Project Settings → Database →
# Connection string no seu projeto Supabase. Sem serviço local de banco — fica hospedado lá.
# ============================================================================
DATABASE_URL=postgresql://postgres:6HP@=$KuRMRcDwU@db.SEUPROJETO.supabase.co:5432/postgres
# DATABASE_SSL=false   # só se estiver usando um Postgres local sem TLS (Supabase sempre exige TLS)

# ============================================================================
# Evolution API — opcional, só se for usar esse provider
# ============================================================================
# EVOLUTION_API_URL=https://evolution.seudominio.com
# EVOLUTION_API_KEY=
# Default true: erro da Evolution vira 502 na API. 'false' restaura modo silencioso
# antigo (erro logado, resposta {} com HTTP 200 — mascara falhas de envio).
# EVOLUTION_THROW_ON_ERROR=true
# EVOLUTION_TIMEOUT_MS=15000

# ============================================================================
# Z-API e Meta Cloud API não têm credenciais globais — cada instância é criada com as suas
# próprias via POST /v1/instances (ver README, seção "API HTTP").
#
# Meta Cloud API — valores globais OPCIONAIS. O App Secret é do APP da Meta (vale para todos os
# números do app), então o normal é definir uma vez aqui; uma instância pode sobrescrever em
# credentials.appSecret. SEM App Secret os webhooks NÃO são validados (X-Hub-Signature-256).
# ============================================================================
# WHATSAPP_CLOUD_APP_SECRET=
# Opcional: fixa o token do handshake GET (hub.verify_token). Na API HTTP ele é gerado por
# instância na criação e devolvido em `webhook.verifyToken`.
# WHATSAPP_CLOUD_VERIFY_TOKEN=
